# Copie para .env (ou exporte no terminal). NUNCA versione a chave real.
ANTHROPIC_API_KEY=            # opcional; vazio = modo offline
ANTHROPIC_MODEL=claude-sonnet-5-5
FORZY_MODO=auto               # auto | llm | offline
RAG_TOP_K=4                   # trechos de documentação por resposta
RAG_MIN_SCORE=0.12            # similaridade mínima para aceitar um trecho
# FORZY_BASE_DIR=/caminho/para/forzy-assistente   # opcional
